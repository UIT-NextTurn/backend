# ==============================================================================
# NextTurn Backend Environment Variables Template (.env.example)
# Duplicate this file as .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Container Configuration
# ------------------------------------------------------------------------------
CONTAINER_NAME=nextturn-backend
SERVER_PORT=8080
PORT_MAPPING=8080:8080
APP_SERVER_URL=http://localhost:8080
API_DOCS_SERVER_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. MySQL Relational Database Configuration
# Compatible with Oracle MySQL HeatWave & Local MySQL 8.4 LTS
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nextturn_master?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=nextturn
SPRING_DATASOURCE_PASSWORD=nextturn_dev_secret

# ------------------------------------------------------------------------------
# 3. JPA / Hibernate ORM Configuration
# ------------------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# 3.1 Flyway Database Migration Configuration
# Controlled by CI/CD pipeline. Keep false for Spring Boot runtime startup.
# ------------------------------------------------------------------------------
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_LOCATIONS=classpath:db/migration/central

# ------------------------------------------------------------------------------
# 4. Valkey In-Memory Cache & SSE Real-time Notification Store
# ------------------------------------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Application Localization & Timezone
# ------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 6. Keycloak OAuth2 & OIDC IAM Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_CLIENT_ID=nextturn-backend
KEYCLOAK_REALM=nextturn
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/nextturn
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/nextturn/protocol/openid-connect/certs
# Frontend OAuth callback URL - depends on your frontend web domain / reverse proxy host
# e.g., http://localhost:3000/auth/callback for local dev or https://yourdomain.com/auth/callback in production
AUTH_DEFAULT_REDIRECT_URI=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# 7. Cross-Origin Resource Sharing CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_MAX_AGE_SECONDS=3600
CORS_ALLOW_CREDENTIALS=true

